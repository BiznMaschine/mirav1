{
  "name": "ux-prototype",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "ux-prototype/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/ux-prototype/dist"],
      "options": {
        "command": "pnpm --filter @mira/ui build && pnpm --filter @mira/ux-prototype build",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": []
}

